# Copiar a .env para desarrollo local
NODE_ENV=development
PORT=3000

# URL PostgreSQL de Supabase o PostgreSQL local
DATABASE_URL=postgresql://usuario:password@host:5432/postgres
DB_SSL=false

# Generar una cadena larga y aleatoria. Nunca subir el valor real a GitHub.
SESSION_SECRET=reemplazar-por-una-clave-larga-y-aleatoria
